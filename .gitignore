# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode user state (generated, machine-specific)
xcuserdata/
*.xcuserdatad/
*.xcuserstate
*.xcscmblueprint
DerivedData/
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.pins
Package.resolved

# CocoaPods (if added later)
Pods/

# Carthage (if added later)
Carthage/Build/
Carthage/Checkouts/

# fastlane (if added later)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# Secrets / signing
.env
.env.local
*.pem
*.p12
*.cer
*.mobileprovision

# Editor noise
.idea/
.vscode/
*.swp
*~

# Build/test artifacts
*.xcresult/
# Raw capture output is an artifact; the curated App Store sets under store/ and
# store-v2/ are deliverables. Git cannot re-include a path inside an excluded
# directory, so screenshots/ itself has to stay un-excluded and its contents
# excluded individually.
screenshots/*
!screenshots/store/
!screenshots/store-v2/
