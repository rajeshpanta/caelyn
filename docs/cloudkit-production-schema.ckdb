DEFINE SCHEMA

    RECORD TYPE CD_CycleEntry (
        CD_basalTemperature             DOUBLE QUERYABLE SORTABLE,
        CD_cervicalMucus                BYTES QUERYABLE SORTABLE,
        CD_createdAt                    TIMESTAMP QUERYABLE SORTABLE,
        CD_date                         TIMESTAMP QUERYABLE SORTABLE,
        CD_dayKey                       INT64 QUERYABLE SORTABLE,
        CD_energyLevel                  BYTES QUERYABLE SORTABLE,
        CD_entityName                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_flow                         BYTES QUERYABLE SORTABLE,
        CD_loggedCustomSymptoms         BYTES QUERYABLE SORTABLE,
        CD_loggedCustomSymptoms_ckAsset ASSET,
        CD_medication                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_medication_ckAsset           ASSET,
        CD_mood                         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt                  BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset          ASSET,
        CD_note                         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_noteReminderAt               TIMESTAMP QUERYABLE SORTABLE,
        CD_noteReminderDone             INT64 QUERYABLE SORTABLE,
        CD_noteReminderRule             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_noteReminderRule_ckAsset     ASSET,
        CD_note_ckAsset                 ASSET,
        CD_ovulationTestResult          BYTES QUERYABLE SORTABLE,
        CD_pain                         INT64 QUERYABLE SORTABLE,
        CD_painTypes                    BYTES QUERYABLE SORTABLE,
        CD_painTypes_ckAsset            ASSET,
        CD_pregnancyTest                INT64 QUERYABLE SORTABLE,
        CD_sexualActivity               INT64 QUERYABLE SORTABLE,
        CD_symptomSeverity              BYTES QUERYABLE SORTABLE,
        CD_symptomSeverity_ckAsset      ASSET,
        CD_symptoms                     BYTES QUERYABLE SORTABLE,
        CD_symptoms_ckAsset             ASSET,
        CD_updatedAt                    TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"                 TIMESTAMP,
        "___createdBy"                  REFERENCE,
        "___etag"                       STRING,
        "___modTime"                    TIMESTAMP,
        "___modifiedBy"                 REFERENCE,
        "___recordID"                   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_UserProfile (
        CD_accountLinked               INT64 QUERYABLE SORTABLE,
        CD_appleSuggestedName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_appleSuggestedName_ckAsset  ASSET,
        CD_autoWipeAfterDays           INT64 QUERYABLE SORTABLE,
        CD_autoWipeEnabled             INT64 QUERYABLE SORTABLE,
        CD_averageCycleLength          INT64 QUERYABLE SORTABLE,
        CD_averagePeriodLength         INT64 QUERYABLE SORTABLE,
        CD_birthControlEnabled         INT64 QUERYABLE SORTABLE,
        CD_birthControlMethod          BYTES QUERYABLE SORTABLE,
        CD_birthControlReminderEnabled INT64 QUERYABLE SORTABLE,
        CD_birthControlReminderHour    INT64 QUERYABLE SORTABLE,
        CD_birthControlReminderMinute  INT64 QUERYABLE SORTABLE,
        CD_birthControlStartDate       TIMESTAMP QUERYABLE SORTABLE,
        CD_createdAt                   TIMESTAMP QUERYABLE SORTABLE,
        CD_customSymptoms              BYTES QUERYABLE SORTABLE,
        CD_customSymptoms_ckAsset      ASSET,
        CD_dailyCheckInHour            INT64 QUERYABLE SORTABLE,
        CD_dailyCheckInMinute          INT64 QUERYABLE SORTABLE,
        CD_endoEnabled                 INT64 QUERYABLE SORTABLE,
        CD_entityName                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_firstDayOfWeek              INT64 QUERYABLE SORTABLE,
        CD_gentleModeEnabled           INT64 QUERYABLE SORTABLE,
        CD_hasConfirmedPreferredName   INT64 QUERYABLE SORTABLE,
        CD_hasOnboarded                INT64 QUERYABLE SORTABLE,
        CD_hasSeenAccountOffer         INT64 QUERYABLE SORTABLE,
        CD_healthKitConnected          INT64 QUERYABLE SORTABLE,
        CD_hidePreview                 INT64 QUERYABLE SORTABLE,
        CD_hkReadFertility             INT64 QUERYABLE SORTABLE,
        CD_hkReadFlow                  INT64 QUERYABLE SORTABLE,
        CD_hkReadSymptoms              INT64 QUERYABLE SORTABLE,
        CD_hkWriteFlow                 INT64 QUERYABLE SORTABLE,
        CD_hkWriteSymptoms             INT64 QUERYABLE SORTABLE,
        CD_irregularModeDismissed      INT64 QUERYABLE SORTABLE,
        CD_irregularModeEnabled        INT64 QUERYABLE SORTABLE,
        CD_isPro                       INT64 QUERYABLE SORTABLE,
        CD_lastActiveAt                TIMESTAMP QUERYABLE SORTABLE,
        CD_lastPeriodStart             TIMESTAMP QUERYABLE SORTABLE,
        CD_lockEnabled                 INT64 QUERYABLE SORTABLE,
        CD_medicationHour              INT64 QUERYABLE SORTABLE,
        CD_medicationMinute            INT64 QUERYABLE SORTABLE,
        CD_moveReceipt                 BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset         ASSET,
        CD_ovulationReminderHour       INT64 QUERYABLE SORTABLE,
        CD_ovulationReminderMinute     INT64 QUERYABLE SORTABLE,
        CD_pcosEnabled                 INT64 QUERYABLE SORTABLE,
        CD_perimenoEnabled             INT64 QUERYABLE SORTABLE,
        CD_periodReminderDaysBefore    INT64 QUERYABLE SORTABLE,
        CD_periodReminderHour          INT64 QUERYABLE SORTABLE,
        CD_periodReminderMinute        INT64 QUERYABLE SORTABLE,
        CD_postpartumBirthDate         TIMESTAMP QUERYABLE SORTABLE,
        CD_postpartumEnabled           INT64 QUERYABLE SORTABLE,
        CD_preferredName               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_preferredName_ckAsset       ASSET,
        CD_pregnancyDueDate            TIMESTAMP QUERYABLE SORTABLE,
        CD_pregnancyEnabled            INT64 QUERYABLE SORTABLE,
        CD_privateNotifications        INT64 QUERYABLE SORTABLE,
        CD_remindDailyCheckIn          INT64 QUERYABLE SORTABLE,
        CD_remindMedication            INT64 QUERYABLE SORTABLE,
        CD_remindOvulation             INT64 QUERYABLE SORTABLE,
        CD_remindPeriodStart           INT64 QUERYABLE SORTABLE,
        CD_theme                       BYTES QUERYABLE SORTABLE,
        CD_trackingGoals               BYTES QUERYABLE SORTABLE,
        CD_trackingGoals_ckAsset       ASSET,
        CD_ttcEnabled                  INT64 QUERYABLE SORTABLE,
        "___createTime"                TIMESTAMP,
        "___createdBy"                 REFERENCE,
        "___etag"                      STRING,
        "___modTime"                   TIMESTAMP,
        "___modifiedBy"                REFERENCE,
        "___recordID"                  REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CaelynCloudDeletion (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        deletedAt       TIMESTAMP QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
